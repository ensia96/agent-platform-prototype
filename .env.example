PORT=8787

# Optional. The env-backed OpenAI-compatible profile reads this at runtime.
# The key value is not stored in SQLite; only credentialRef=env:OPENAI_API_KEY is shown.
# Mock is the default when this is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Experimental. OpenAI ChatGPT/Codex OAuth channel uses consumer subscription quota,
# not OpenAI Platform API key billing. Tokens are stored under .agent-platform/credentials/.
OPENAI_CHATGPT_MODEL=gpt-5.5
OPENAI_CHATGPT_ENDPOINT=https://chatgpt.com/backend-api/codex/responses
# Optional override for development/testing. The default issuer is https://auth.openai.com.
OPENAI_CHATGPT_AUTH_ISSUER=https://auth.openai.com
# Optional sanitized runtime diagnostics. Does not print OAuth tokens.
OPENAI_CHATGPT_DEBUG=0
